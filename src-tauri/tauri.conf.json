{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynamic Themed Wallpapers",
  "version": "0.1.0",
  "identifier": "app.dynamicthemedwallpapers",
  "build": {
    "beforeDevCommand": "./node_modules/.bin/vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./node_modules/.bin/vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dynamic Themed Wallpapers",
        "width": 420,
        "height": 880,
        "minWidth": 340,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://thumb.wikimedia.org https://upload.wikimedia.org https://images.unsplash.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
